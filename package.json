{
  "name": "community-people-finder",
  "version": "1.0.0",
  "description": "Ask in plain language, get real community members from their ENS profiles, or an honest 'nobody fits'.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "cases": "tsx scripts/run-cases.ts",
    "set-profile": "tsx scripts/set-profile.ts",
    "seed": "tsx scripts/seed.ts"
  },
  "engines": { "node": ">=20" },
  "dependencies": { "viem": "^2.21.0", "zod": "^3.23.8" },
  "devDependencies": { "@types/node": "^22.0.0", "tsx": "^4.19.0", "typescript": "^5.6.0" }
}
